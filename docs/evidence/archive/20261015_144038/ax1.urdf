    <!-- 임시 사양, 기계적 제한과 모터 사양 반영 필요 -->
    <limit effort="5" lower="-1.57" upper="1.57" velocity="1.0"/>
    <dynamics damping="0.3" friction="0.0"/>
  </joint>
  <!-- 그리퍼 회전 베이스 -->
  <link name="gripper_base_link">
