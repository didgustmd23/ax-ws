    <!-- 임시 사양, 기계적 제한과 모터 사양 반영 필요 -->
    <limit effort="15" lower="-2.0" upper="2.0" velocity="1.0"/>
    <dynamics damping="1.0" friction="0.0"/>
  </joint>
  <!-- 로봇팔 손목 -->
  <link name="wrist_link">
    <visual>
      <origin rpy="1.570796 0 0" xyz="0 0 0"/>
