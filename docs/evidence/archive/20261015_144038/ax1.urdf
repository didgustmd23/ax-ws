    <!-- 회전 관절 제한: lower/upper=각도(rad), effort=최대 토크(N·m), velocity=최대 각속도(rad/s) -->
    <limit effort="10.0" lower="-3.14159" upper="3.14159" velocity="1.0"/>
    <!-- 관절 운동 저항: damping은 속도에 비례하는 감쇠, friction은 마찰 저항 -->
    <dynamics damping="3.0" friction="0.0"/>
