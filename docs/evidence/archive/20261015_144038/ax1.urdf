      <mass value="0.05"/>
      <inertia ixx="3.541666666666667e-06" ixy="0" ixz="0" iyy="4.427083333333334e-05" iyz="0" izz="4.2604166666666675e-05"/>
    </inertial>
  </link>
  <!-- 왼쪽 손가락의 직선 이동 관절: 양의 변위는 +Y 방향으로 이동하여 그리퍼를 벌림 -->
  <joint name="left_finger_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="left_finger_link"/>
    <origin rpy="0 0 0" xyz="0.02 0.025 0"/>
    <axis xyz="0 1 0"/>
    <!-- 임시 사양, 기계적 제한과 모터 사양 반영 필요 -->
    <!-- 직선 관절 제한: 변위 -0.01~0.02 m, 최대 힘 20 N, 최대 속도 0.05 m/s -->
    <limit effort="20.0" lower="-0.01" upper="0.02" velocity="0.05"/>
  </joint>
  <!-- 오른손 그리퍼 손가락 -->
  <link name="right_finger_link">
    <visual>
      <origin rpy="0 0 0" xyz="0.05 0 0"/>
      <geometry>
        <box size="0.10 0.015 0.025"/>
      </geometry>
      <material name="right_finger_green">
        <color rgba="0.2 0.8 0.3 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0.05 0 0"/>
      <geometry>
        <box size="0.1 0.015 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0.05 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="3.541666666666667e-06" ixy="0" ixz="0" iyy="4.427083333333334e-05" iyz="0" izz="4.2604166666666675e-05"/>
    </inertial>
  </link>
  <!-- 오른쪽 손가락의 직선 이동 관절: 양의 변위는 -Y 방향으로 이동하여 그리퍼를 벌림 -->
  <joint name="right_finger_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="right_finger_link"/>
    <origin rpy="0 0 0" xyz="0.02 -0.025 0"/>
    <axis xyz="0 -1 0"/>
    <!-- 임시 사양, 기계적 제한과 모터 사양 반영 필요 -->
    <!-- 직선 관절 제한: 변위 -0.01~0.02 m, 최대 힘 20 N, 최대 속도 0.05 m/s -->
    <limit effort="20.0" lower="-0.01" upper="0.02" velocity="0.05"/>
    <!-- mimic 설정은 비활성 상태이며 두 손가락은 각각의 위치 제어기로 구동 -->
    <!-- <mimic joint="left_finger_joint" multiplier="1.0" offset="0.0"/> -->
    <dynamics damping="1.0" friction="0.0"/>
  </joint>
  <!-- LiDAR 본체의 시각 형상, 충돌 형상 및 관성 정의 -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder length="0.05" radius="0.04"/>
      </geometry>
      <material name="lidar_black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.05" radius="0.04"/>
      </geometry>
    </collision>
