  <!-- 팔 받침대와 회전 베이스 연결: Z축 회전으로 팔의 수평 방향 조절 -->
  <joint name="arm_yaw_joint" type="revolute">
    <parent link="arm_mount_link"/>
    <child link="arm_rotating_base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.065"/>
