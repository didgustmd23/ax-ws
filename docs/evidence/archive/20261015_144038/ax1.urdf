  <!-- 회전 베이스와 상완 연결: Y축 회전으로 어깨의 굽힘 각도 조절 -->
  <joint name="shoulder_joint" type="revolute">
    <parent link="arm_rotating_base_link"/>
    <child link="upper_arm_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.055"/>
    <!-- Y축 회전 설정 -->
    <axis xyz="0 1 0"/>
    <!-- 임시 사양, 기계적 제한과 모터 사양 반영 필요 -->
    <limit effort="20.0" lower="-1.5708" upper="1.5708" velocity="1.0"/>
    <dynamics damping="2.0" friction="0.0"/>
  </joint>
  <!-- 로봇팔 전완 -->
  <link name="forearm_link">
    <visual>
