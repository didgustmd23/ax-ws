      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.00012166666666666668" ixy="0" ixz="0" iyy="0.00012166666666666668" iyz="0" izz="0.00016"/>
    </inertial>
  </link>
  <!-- LiDAR를 차체에 고정: 차체 원점에서 전방 0.20 m, 위쪽 0.16 m에 배치 -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin rpy="0 0 0" xyz="0.20 0 0.16"/>
  </joint>
  <!-- 라이다 센서 설정 -->
  <gazebo reference="lidar_link">
    <sensor name="ax1_lidar" type="gpu_lidar">
      <!-- 센서 측정 좌표를 lidar_link 원점 및 방향과 일치시킴 -->
      <pose>0 0 0 0 0 0</pose>
      <!-- Gazebo 센서 출력 토픽: ROS에서 사용하려면 별도의 브리지 필요 -->
      <topic>/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <!-- 초당 10회 측정하며 센서를 항상 활성화하고 스캔 시각화 사용 -->
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <!-- 참고용 360도 스캔 설정: 현재 비활성화 -->
          <!-- <horizontal>
                        <samples>360</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.141592</min_angle>
                        <max_angle>3.141592</max_angle>
                    </horizontal> -->
          <!-- 현재 수평 스캔: 전방 180도(-90도~+90도), 181개 샘플, 샘플 해상도 배율 1 -->
          <horizontal>
            <samples>181</samples>
            <resolution>1</resolution>
            <min_angle>-1.570796</min_angle>
            <max_angle>1.570796</max_angle>
          </horizontal>
        </scan>
        <!-- 거리 측정 범위 0.12~10.0 m, 거리 해상도 0.01 m -->
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>
  <!-- GPU LiDAR 동작에 필요한 Gazebo 센서 시스템: Ogre2 렌더링 엔진 사용 -->
  <gazebo>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>
  <!-- 4개 바퀴를 좌우 쌍으로 구동하는 차동 구동 시스템: 바퀴 간격과 반지름으로 주행 계산 -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.39</wheel_separation>
      <wheel_radius>0.08</wheel_radius>
    </plugin>
  </gazebo>
  <!-- 어깨 관절 위치 제어: Gazebo 명령 토픽으로 목표 각도(rad) 수신 -->
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>shoulder_joint</joint_name>
      <topic>/model/ax1/shoulder_joint/position</topic>
      <!-- 위치 오차에 대한 비례 이득: 값이 클수록 오차에 대한 제어 출력 증가 -->
      <p_gain>10</p_gain>
    </plugin>
  </gazebo>
  <!-- 팔꿈치 관절 위치 제어: Gazebo 명령 토픽으로 목표 각도(rad) 수신 -->
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>elbow_joint</joint_name>
      <topic>/model/ax1/elbow_joint/position</topic>
      <p_gain>10</p_gain>
    </plugin>
  </gazebo>
  <!-- 손목 관절 위치 제어: Gazebo 명령 토픽으로 목표 각도(rad) 수신 -->
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>wrist_joint</joint_name>
      <topic>/model/ax1/wrist_joint/position</topic>
      <p_gain>5</p_gain>
    </plugin>
  </gazebo>
  <!-- 왼쪽 손가락 위치 제어: Gazebo 명령 토픽으로 목표 변위(m) 수신 -->
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>left_finger_joint</joint_name>
      <topic>/model/ax1/left_finger_joint/position</topic>
      <p_gain>100</p_gain>
    </plugin>
  </gazebo>
  <!-- 오른쪽 손가락 위치 제어: Gazebo 명령 토픽으로 목표 변위(m) 수신 -->
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>right_finger_joint</joint_name>
      <topic>/model/ax1/right_finger_joint/position</topic>
      <p_gain>100</p_gain>
    </plugin>
  </gazebo>
  <!-- 그리퍼 회전 관절 위치 제어: Gazebo 명령 토픽으로 목표 각도(rad) 수신 -->
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>gripper_rotation_joint</joint_name>
      <topic>/model/ax1/gripper_rotation_joint/position</topic>
      <p_gain>5</p_gain>
    </plugin>
  </gazebo>
  <!-- 팔 회전 베이스 위치 제어: Gazebo 명령 토픽으로 목표 각도(rad) 수신 -->
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>arm_yaw_joint</joint_name>
      <topic>/model/ax1/arm_yaw_joint/position</topic>
      <p_gain>3</p_gain>
    </plugin>
  </gazebo>
</robot>
