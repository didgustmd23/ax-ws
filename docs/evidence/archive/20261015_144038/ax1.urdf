      <mass value="0.2"/>
      <inertia ixx="7.166666666666667e-05" ixy="0" ixz="0" iyy="7.166666666666667e-05" iyz="0" izz="9e-05"/>
    </inertial>
  </link>
  <!-- 손목과 그리퍼 베이스 연결: X축 회전으로 그리퍼의 롤 각도 조절 -->
  <joint name="gripper_rotation_joint" type="revolute">
    <parent link="wrist_link"/>
    <child link="gripper_base_link"/>
    <origin rpy="0 0 0" xyz="0.055 0 0"/>
    <axis xyz="1 0 0"/>
    <!-- 임시 사양, 기계적 제한과 모터 사양 반영 필요 -->
    <limit effort="5.0" lower="-3.14159" upper="3.14159" velocity="1.0"/>
    <dynamics damping="1.0" friction="0.0"/>
  </joint>
  <!-- 왼쪽 그리퍼 손가락 -->
  <link name="left_finger_link">
    <visual>
      <origin rpy="0 0 0" xyz="0.05 0 0"/>
      <geometry>
        <box size="0.10 0.015 0.025"/>
      </geometry>
      <material name="left_finger_green">
        <color rgba="0.2 0.8 0.3 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0.05 0 0"/>
