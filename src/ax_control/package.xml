<?xml version="1.0"?>
<package format="3">
  <name>ax_control</name>
  <version>0.1.0</version>
  <description>AX simulation control configuration and launch.</description>

  <maintainer email="yhs@todo.todo">yhs</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>gz_sim_vendor</depend>
  <depend>gz_plugin_vendor</depend>
  <depend>gz_transport_vendor</depend>
