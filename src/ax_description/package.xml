<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ax_description</name>
  <version>0.0.0</version>
  <description>AX mesh robot model, selectable grippers, and RViz display launch.</description>
  <maintainer email="yhs@todo.todo">yhs</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robotiq_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
    <!-- model://ax_description/... 해석에는 패키지 share 폴더의 부모가 필요하다.
         ros_gz_sim이 이 경로를 서버·GUI의 GZ_SIM_RESOURCE_PATH에 전달한다. -->
    <gazebo_ros gazebo_model_path="${prefix}/../"/>
  </export>
</package>
