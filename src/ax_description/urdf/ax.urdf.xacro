<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ax">
    <!-- RViz display selects robotiq; the existing simulation defaults to the primitive gripper. -->
    <xacro:arg name="gripper_model" default="primitive"/>
    <xacro:arg name="robot_name" default="ax"/>
    <xacro:arg name="frame_prefix" default=""/>
    <xacro:arg name="sensor_robot_id" default="robot_1"/>
    <!-- ros2_control: controller_manager namespace와 launch가 만든 제어기 설정 파일(절대 경로). -->
    <!-- 설정 파일이 비어 있으면 gz_ros2_control 플러그인 없이 표시·정적 검사용 모델만 만든다. -->
    <xacro:arg name="ros_namespace" default=""/>
    <xacro:arg name="ros2_control_params" default=""/>
    <xacro:property name="model_name" value="$(arg robot_name)"/>
    <xacro:property name="frames" value="$(arg frame_prefix)"/>
    <xacro:include filename="sensors.xacro"/>
    <xacro:include filename="ros2_control.xacro"/>
    <xacro:property name="gripper_model_ids" value="${dict(primitive=0, robotiq=1, parallel_wide=2, suction=3)}"/>
    <xacro:property name="gripper_model_id" value="${gripper_model_ids['$(arg gripper_model)']}"/>
    <xacro:property name="use_robotiq_gripper" value="${gripper_model_id == 1}"/>
    <xacro:property name="use_primitive_gripper" value="${gripper_model_id == 0}"/>
    <xacro:include filename="$(find ax_description)/urdf/test_grippers.xacro"/>
    <xacro:include filename="$(find ax_description)/urdf/physical_properties.xacro"/>
    <xacro:include filename="$(find robotiq_description)/urdf/robotiq_2f_85_macro.urdf.xacro"/>

    <!-- 단위: 길이 m, 질량 kg, 각도 rad. 관절의 axis는 관절 좌표계 기준이며 rpy는 roll, pitch, yaw 순서 -->
    <!-- 몸통·바퀴·팔은 분리 OBJ 외형을 사용한다. 관절축은 형상 추정값, 질량·제어값은 개발용 설정이다. -->
    <!-- 차체 기준 +X=전방, +Y=왼쪽, +Z=위쪽. joint origin은 부모 기준, visual/collision origin은 해당 Link 기준이다. -->
    <!-- visual=표시 외형, collision=접촉 계산 형상, inertial=질량 중심과 관성이다. 메시 원점 보정과 관절 위치는 구분한다. -->
    <!-- 차체·팔 충돌/질량 특성은 tools/generate_physical_properties.py가 생성한다. -->
    <!-- src/ax_description/config/physical_properties.json에 부품별 가정과 계산값을 기록한다. -->
    <!-- 바퀴와 공통 집게 어댑터는 기존 단순 형상 근사를 유지한다. -->
    <xacro:property name="wheel_mass" value="0.5"/>
    <xacro:property name="wheel_separation" value="0.622"/>

    <!-- 그리퍼 베이스 질량 -->
    <xacro:property name="gripper_base_mass" value="0.2"/>
    <!-- 그리퍼 베이스 크기 -->
    <xacro:property name="gripper_base_radius" value="0.03"/>
    <xacro:property name="gripper_base_length" value="0.04"/>

    <!-- 그리퍼 손가락 질량 -->
    <xacro:property name="finger_mass" value="0.05"/>
    <!-- 그리퍼 손가락 크기 -->
    <xacro:property name="finger_length" value="0.10"/>
    <xacro:property name="finger_width" value="0.015"/>
    <xacro:property name="finger_height" value="0.025"/>

    <!-- 원통형 바퀴의 질량과 관성 텐서: 원통 중심을 질량 중심으로 두고 로컬 Z축을 회전축으로 사용 -->
    <xacro:macro name="wheel_inertial">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="${wheel_mass}"/>
            <inertia ixx="${wheel_mass / 12.0 * (3 * wheel_radius**2 + wheel_width**2)}"
                 ixy="0" 
                 ixz="0" 
                 iyy="${wheel_mass / 12.0 * (3 * wheel_radius**2 + wheel_width**2)}" 
                 iyz="0" 
                 izz="${0.5 * wheel_mass * wheel_radius**2}"/>
        </inertial>
    </xacro:macro>

    <!-- 바퀴의 물리 충돌 형상을 반지름과 폭으로 정의 -->
    <xacro:macro name="wheel_collision">
        <collision>
            <geometry>
                <cylinder radius="${wheel_radius}" 
                            length="${wheel_width}"/>
            </geometry>
        </collision>
    </xacro:macro>

    <!-- 원통의 질량과 관성 텐서 생성: roll, pitch, yaw로 관성 좌표계의 방향 지정 -->
    <xacro:macro name="cylinder_inertial" params="mass radius length roll:=0 pitch:=0 yaw:=0">
        <inertial>
            <origin xyz="0 0 0" rpy="${roll} ${pitch} ${yaw}"/>
            <mass value="${mass}"/>
            <inertia 
                ixx="${mass / 12.0 * (3 * radius**2 + length**2)}" 
                ixy="0" 
                ixz="0" 
                iyy="${mass / 12.0 * (3 * radius**2 + length**2)}" 
                iyz="0" 
                izz="${0.5 * mass * radius**2}"/>
        </inertial>
    </xacro:macro>

    <!-- 링크 원점에 중심을 둔 원통형 충돌 형상 생성 -->
    <xacro:macro name="cylinder_collision" params="radius length">
        <collision>
            <geometry>
                <cylinder radius="${radius}" length="${length}"/>
            </geometry>
        </collision>
    </xacro:macro>

    <!-- 직육면체의 질량과 관성 텐서 생성: length=X, width=Y, height=Z, cx/cy/cz=질량 중심 -->
    <xacro:macro name="box_inertial" params="mass width height length cx cy cz">
        <inertial>
            <origin xyz="${cx} ${cy} ${cz}" rpy="0 0 0"/>
            <mass value="${mass}"/>
            <inertia 
                ixx="${mass / 12.0 * (width**2 + height**2)}" 
                ixy="0" 
                ixz="0" 
                iyy="${mass / 12.0 * (length**2 + height**2)}" 
                iyz="0" 
                izz="${mass / 12.0 * (length**2 + width**2)}"/>
        </inertial>
    </xacro:macro>

    <!-- 직육면체 충돌 형상 생성: cx/cy/cz로 링크 원점에 대한 형상 중심 위치 지정 -->
    <xacro:macro name="box_collision" params="length width height cx cy cz">
        <collision>
            <origin xyz="${cx} ${cy} ${cz}" rpy="0 0 0"/>
            <geometry>
                <box size="${length} ${width} ${height}"/>
            </geometry>
        </collision>
    </xacro:macro>

    <!-- 로봇 크기 -->
    <!-- 바퀴 OBJ의 반경 외곽 약 196.309 mm와 폭 144 mm에 맞춘 원통 근사. -->
    <!-- 실제 접지 반지름·질량·관성은 별도 검증 대상이며 diff_drive_controller 설정도 이 근삿값을 사용한다. -->
    <xacro:property name="wheel_radius" value="0.19631"/>
    <xacro:property name="wheel_width" value="0.144"/>

    <!-- 로봇 기준 좌표 -->
    <!-- base_link 원점은 몸통 메시 경계 중심이다. 바퀴는 같은 조립 좌표 변환을 적용했다. -->
    <!-- 팔 배치는 원본 조립 형상 기준이다. 센서 배치는 개발용 설정, collision/inertial은 physical_properties.xacro의 부품별 근사다. -->
    <link name="base_link">
        <visual>
            <!-- AX 몸통 메시: 원본 단위 mm 가정, m로 표시한다. -->
            <!-- 원본 경계 중심 (3, 0, 382.77325)을 base_link 원점에 맞춘 임시 외형 보정이다. -->
            <origin xyz="-0.003 0 -0.38277325" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://ax_description/meshes/parts/AX_1/ax_body.obj"
                      scale="0.001 0.001 0.001"/>
            </geometry>
            <!-- 색상은 OBJ가 참조하는 MTL을 사용한다. -->
        </visual>
        <!-- Component collision boxes and virtual motor/housing mass distribution. -->
        <xacro:ax_physics_base_link/>
    </link>

    <!-- 앞쪽 왼쪽 바퀴 -->
    <link name="front_left_wheel">
        <visual>
            <!-- 원본 조립 좌표에서 바퀴 중심을 빼고 로컬 Z 회전축에 맞춘다. -->
            <origin xyz="-0.440000 0.190000 -0.311000" rpy="${pi / 2} 0 0"/>
            <geometry>
                <mesh filename="package://ax_description/meshes/parts/AX_1/ax_tire_02.obj"
                      scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        <xacro:wheel_collision/>
        <xacro:wheel_inertial/>
    </link>

    <!-- 앞쪽 왼쪽 바퀴의 연속 회전 관절: X축으로 -90도 회전하여 바퀴의 로컬 Z축을 차체 Y축에 정렬 -->
    <joint name="front_left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="front_left_wheel"/>
        <origin xyz="0.437000 0.311000 -0.19277325" rpy="${-pi / 2} 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <!-- 앞쪽 오른쪽 바퀴 -->
    <link name="front_right_wheel">
        <visual>
            <!-- 원본 조립 좌표에서 바퀴 중심을 빼고 로컬 Z 회전축에 맞춘다. -->
            <origin xyz="-0.440000 0.190000 0.311000" rpy="${pi / 2} 0 0"/>
            <geometry>
                <mesh filename="package://ax_description/meshes/parts/AX_1/ax_tire_01.obj"
                      scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        <xacro:wheel_collision/>
        <xacro:wheel_inertial/>
    </link>

    <!-- 앞쪽 오른쪽 바퀴의 연속 회전 관절: 차체 오른쪽에 배치하고 회전축을 차체 Y축에 정렬 -->
    <joint name="front_right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="front_right_wheel"/>
        <origin xyz="0.437000 -0.311000 -0.19277325" rpy="${-pi / 2} 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <!-- 뒤쪽 왼쪽 바퀴 -->
    <link name="rear_left_wheel">
        <visual>
            <!-- 원본 조립 좌표에서 바퀴 중심을 빼고 로컬 Z 회전축에 맞춘다. -->
            <origin xyz="0.440000 0.190000 -0.311000" rpy="${pi / 2} 0 0"/>
            <geometry>
                <mesh filename="package://ax_description/meshes/parts/AX_1/ax_tire_04.obj"
                      scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        <xacro:wheel_collision/>
        <xacro:wheel_inertial/>
    </link>

    <!-- 뒤쪽 왼쪽 바퀴의 연속 회전 관절: 차체 뒤쪽 왼편에 배치 -->
    <joint name="rear_left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="rear_left_wheel"/>
        <origin xyz="-0.443000 0.311000 -0.19277325" rpy="${-pi / 2} 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <!-- 뒤쪽 오른쪽 바퀴 -->
    <link name="rear_right_wheel">
        <visual>
            <!-- 원본 조립 좌표에서 바퀴 중심을 빼고 로컬 Z 회전축에 맞춘다. -->
            <origin xyz="0.440000 0.190000 0.311000" rpy="${pi / 2} 0 0"/>
            <geometry>
                <mesh filename="package://ax_description/meshes/parts/AX_1/ax_tire_03.obj"
                      scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        <xacro:wheel_collision/>
        <xacro:wheel_inertial/>
    </link>

    <!-- 뒤쪽 오른쪽 바퀴의 연속 회전 관절: 차체 뒤쪽 오른편에 배치 -->
    <joint name="rear_right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="rear_right_wheel"/>
        <origin xyz="-0.443000 -0.311000 -0.19277325" rpy="${-pi / 2} 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <!-- 하단 받침·외측 지지 구조: 중앙 원통과 분리한 고정부 -->
    <link name="arm_mount_link">
        <!-- 원본 조립 자세를 q=0으로 사용. 메시 좌표에서 추정 관절 원점을 제거한다. -->
        <visual>
            <origin xyz="-0.18 -0.185 -0.612" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://ax_description/meshes/parts/AX_1/arm_01_support.obj"
                      scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="ax_support_dark_gray">
                <color rgba="0.22 0.25 0.30 1.0"/>
            </material>
        </visual>
        <!-- Component collision boxes and virtual motor/housing mass distribution. -->
        <xacro:ax_physics_arm_mount_link/>
    </link>

    <!-- 차체와 고정 기둥 연결: 기둥 회전축을 base_link의 X/Y 중심에 배치, 높이 유지 -->
    <joint name="arm_mount_joint" type="fixed">
        <parent link="base_link"/>
        <child link="arm_mount_link"/>
        <origin xyz="0 0 0.22922675" rpy="0 0 0"/>
    </joint>

    <!-- 중앙 원통과 3개 링은 함께 회전한다. 바깥 받침·지지 구조는 고정이다. -->
    <link name="column_link">
        <visual>
            <origin xyz="-0.18 -0.185 -0.78" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://ax_description/meshes/parts/AX_1/arm_01_column.obj"
                      scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="ax_column_orange">
                <color rgba="1.0 0.45 0.05 1.0"/>
            </material>
        </visual>
        <!-- Component collision boxes and virtual motor/housing mass distribution. -->
        <xacro:ax_physics_column_link/>
    </link>

    <!-- 원본 원통 중심축 (X=180, Y=185 mm)을 따라 회전. 속도는 v0.1, effort는 미검증 기존값. -->
    <joint name="column_yaw_joint" type="revolute">
        <parent link="arm_mount_link"/>
        <child link="column_link"/>
        <origin xyz="0 0 0.168" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14159" upper="3.14159" effort="10.0" velocity=".35"/>
        <dynamics damping="3.0" friction="0.0"/>
    </joint>

    <!-- 로봇 팔 회전 베이스 -->
    <link name="arm_rotating_base_link">
        <!-- 원본 조립 자세를 q=0으로 사용. 메시 좌표에서 추정 관절 원점을 제거한다. -->
        <visual>
            <origin xyz="-0.18 -0.185 -1.3553438" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://ax_description/meshes/parts/AX_1/arm_02_movie.obj"
                      scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        <!-- Component collision boxes and virtual motor/housing mass distribution. -->
        <xacro:ax_physics_arm_rotating_base_link/>
    </link>

    <!-- 팔의 수평 회전은 column_yaw_joint 하나로 수행한다. 상단 부품은 원통에 고정한다. -->
    <joint name="arm_upper_mount_joint" type="fixed">
        <parent link="column_link"/>
        <child link="arm_rotating_base_link"/>
        <origin xyz="0 0 0.5753438" rpy="0 0 0"/>
    </joint>

    <!-- 로봇팔 상완 -->
    <!-- 상완 Link 원점은 추정 어깨 축이다. 원본 자세에서 상완은 대체로 +Z 방향이다. -->
    <link name="upper_arm_link">
        <!-- 원본 조립 자세를 q=0으로 사용. 메시 좌표에서 추정 관절 원점을 제거한다. -->
        <visual>
            <origin xyz="-0.2944427 -0.185 -1.4553438" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://ax_description/meshes/parts/AX_1/arm_03_upperarm.obj"
                      scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        <!-- Component collision boxes and virtual motor/housing mass distribution. -->
        <xacro:ax_physics_upper_arm_link/>
    </link>

    <!-- 회전 베이스와 상완 연결: OBJ 연결부에서 추정한 X축 회전 -->
    <joint name="shoulder_joint" type="revolute">
        <parent link="arm_rotating_base_link"/>
        <child link="upper_arm_link"/>
        
        <origin xyz="0.1144427 0 0.1" rpy="0 0 0"/>
        <!-- 원형 축 형상에서 추정한 X축 회전. 확정 기구 사양은 별도 확인한다. -->
        <axis xyz="1 0 0"/>

        <!-- AX v0.1 속도 제한 적용. 위치 범위 유지, effort는 토크 산정 전의 미검증 기존값. -->
        <limit lower="-1.5708" upper="1.5708" effort="20.0" velocity=".50"/>
        <dynamics damping="2.0" friction="0.0"/>
    </joint>

    <!-- 로봇팔 전완 -->
    <!-- 전완 Link 원점은 추정 팔꿈치 축이다. q=0은 원본의 비스듬한 조립 자세다. -->
    <link name="forearm_link">
        <!-- 원본 조립 자세를 q=0으로 사용. 메시 좌표에서 추정 관절 원점을 제거한다. -->
        <visual>
            <origin xyz="-0.4264427 -0.185 -2.0153438" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://ax_description/meshes/parts/AX_1/arm_04_forearm.obj"
                      scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        <!-- Component collision boxes and virtual motor/housing mass distribution. -->
        <xacro:ax_physics_forearm_link/>
    </link>

    <!-- 상완 끝에서 전완 연결: OBJ 연결부에서 추정한 X축 회전 -->
    <joint name="elbow_joint" type="revolute">
        <parent link="upper_arm_link"/>
        <child link="forearm_link"/>
        
        <origin xyz="0.132 0 0.56" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>

        <!-- AX v0.1 속도 제한 적용. 위치 범위 유지, effort는 토크 산정 전의 미검증 기존값. -->
        <limit lower="-2.0" upper="2.0" effort="15" velocity=".50"/>
        <dynamics damping="1.0" friction="0.0"/>
    </joint>

    <!-- 로봇팔 손목 -->
    <!-- 손목 하우징 전체를 하나의 링크에 연결한다. 내부 가동부 분리는 아직 수행하지 않았다. -->
    <link name="wrist_link">
        <!-- 원본 조립 자세를 q=0으로 사용. 메시 좌표에서 추정 관절 원점을 제거한다. -->
        <visual>
            <origin xyz="-0.5164427 -0.64 -1.5753438" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://ax_description/meshes/parts/AX_1/gripper_wristhousing.obj"
                      scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        <!-- Component collision boxes and virtual motor/housing mass distribution. -->
        <xacro:ax_physics_wrist_link/>
    </link>
    
    <!-- 전완 끝에서 손목 연결: 원본 끝단 연결부에서 추정한 X축 회전 -->
    <joint name="wrist_joint" type="revolute">
        <parent link="forearm_link"/>
        <child link="wrist_link"/>

        <origin xyz="0.09 0.455 -0.44" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>

        <!-- AX v0.1 속도 제한 적용. 위치 범위 유지, effort는 토크 산정 전의 미검증 기존값. -->
        <limit lower="-1.57" upper="1.57" effort="5" velocity=".70"/>
        <dynamics damping="0.3" friction="0.0"/>
    </joint>

    <!-- 그리퍼 회전 베이스 -->
    <!-- 원통을 pitch=π/2로 회전해 축을 X축 방향에 정렬한다. gripper_rotation_joint의 회전축과 맞춘다. -->
    <link name="gripper_base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 1.570796 0"/>
            <geometry>
                <cylinder radius="0.03" length="0.04"/>
            </geometry>

            <material name="gripper_yellow">
                <color rgba="1.0 0.8 0.1 1"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 1.570796 0"/>
            <geometry>
                <cylinder
                    radius="${gripper_base_radius}"
                    length="${gripper_base_length}"/>
            </geometry>
        </collision>

        <xacro:cylinder_inertial
            mass="${gripper_base_mass}"
            radius="${gripper_base_radius}"
            length="${gripper_base_length}"
            pitch="1.570796"/>
    </link>
    
    <!-- 손목 하단에 기존 임시 그리퍼 연결: 로컬 X축을 아래쪽으로 돌려 롤 축으로 사용 -->
    <joint name="gripper_rotation_joint" type="revolute">
        <parent link="wrist_link"/>
        <child link="gripper_base_link"/>

        <origin xyz="0 0 -0.274" rpy="0 ${pi / 2} 0"/>
        <axis xyz="1 0 0"/>

        <!-- AX v0.1 속도 제한 적용. 위치 범위 유지, effort는 토크 산정 전의 미검증 기존값. -->
        <limit lower="-3.14159" upper="3.14159" effort="5.0" velocity=".70"/>
        <dynamics damping="1.0" friction="0.0"/>
    </joint>

    <!-- AX wrist roll is shared. Robotiq local +Z points along AX adapter +X (downward at rest). -->
    <xacro:if value="${use_robotiq_gripper}">
        <xacro:robotiq_gripper name="ax_robotiq" prefix="" parent="gripper_base_link"
                               include_ros2_control="false">
            <origin xyz="0.02 0 0" rpy="0 ${pi / 2} 0"/>
        </xacro:robotiq_gripper>
    </xacro:if>

    <xacro:if value="${use_primitive_gripper}">
    <!-- 왼쪽 그리퍼 손가락 -->
    <!-- 손가락 외형 중심은 Link 원점에서 +X 0.05 m이며, 이동량은 joint origin에 더해진다. -->
    <link name="left_finger_link">
        <visual>
            <origin xyz="0.05 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.10 0.015 0.025"/>
            </geometry>

            <material name="left_finger_green">
                <color rgba="0.2 0.8 0.3 1"/>
            </material>
        </visual>

        <xacro:box_collision
            length="0.10"
            width="0.015"
            height="0.025"
            cx="0.05"
            cy="0"
            cz="0"/>

        <xacro:box_inertial
            mass="${finger_mass}"
            length="${finger_length}"
            width="${finger_width}"
            height="${finger_height}"
            cx="0.05"
            cy="0"
            cz="0"/>

    </link>

    <!-- 왼쪽 손가락의 직선 이동 관절: 양의 변위는 +Y 방향으로 이동하여 그리퍼를 벌림 -->
    <joint name="left_finger_joint" type="prismatic">
        <parent link="gripper_base_link"/>
        <child link="left_finger_link"/>

        <origin xyz="0.02 0.025 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>

        <!-- AX v0.1 속도 제한 적용. 위치 범위 유지, effort는 토크 산정 전의 미검증 기존값. -->
        <!-- 직선 관절 제한: 변위 -0.01~0.02 m, 최대 힘 20 N, 최대 속도 0.05 m/s -->
        <limit lower="-0.01" upper="0.02" effort="20.0" velocity="0.05"/>
    </joint>

    <!-- 오른손 그리퍼 손가락 -->
    <!-- 양쪽 손가락에 같은 양의 목표 변위를 주면 서로 반대 방향으로 벌어진다. 값은 전체 개구 폭이 아니다. -->
    <link name="right_finger_link">
        <visual>
            <origin xyz="0.05 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.10 0.015 0.025"/>
            </geometry>

            <material name="right_finger_green">
                <color rgba="0.2 0.8 0.3 1"/>
            </material>
        </visual>

        <xacro:box_collision
            length="${finger_length}"
            width="${finger_width}"
            height="${finger_height}"
            cx="0.05"
            cy="0"
            cz="0"/>

        <xacro:box_inertial
            mass="${finger_mass}"
            length="${finger_length}"
            width="${finger_width}"
            height="${finger_height}"
            cx="0.05"
            cy="0"
            cz="0"/>

    </link>

    <!-- 오른쪽 손가락의 직선 이동 관절: 양의 변위는 -Y 방향으로 이동하여 그리퍼를 벌림 -->
    <joint name="right_finger_joint" type="prismatic">
        <parent link="gripper_base_link"/>
        <child link="right_finger_link"/>

        <origin xyz="0.02 -0.025 0" rpy="0 0 0"/>
        <axis xyz="0 -1 0"/>

        <!-- AX v0.1 속도 제한 적용. 위치 범위 유지, effort는 토크 산정 전의 미검증 기존값. -->
        <!-- 직선 관절 제한: 변위 -0.01~0.02 m, 최대 힘 20 N, 최대 속도 0.05 m/s -->
        <limit lower="-0.01" upper="0.02" effort="20.0" velocity="0.05"/>
        <!-- mimic 설정은 비활성 상태이며 두 손가락은 finger_controller(위치 그룹 제어기)가 각각 구동 -->
        <!-- <mimic joint="left_finger_joint" multiplier="1.0" offset="0.0"/> -->
        <dynamics damping="1.0" friction="0.0"/>
    </joint>

    </xacro:if>

    <xacro:if value="${gripper_model_id == 2}">
        <xacro:ax_parallel_wide_gripper parent="gripper_base_link">
            <origin xyz="0.02 0 0" rpy="0 ${pi / 2} 0"/>
        </xacro:ax_parallel_wide_gripper>
    </xacro:if>
    <xacro:if value="${gripper_model_id == 3}">
        <xacro:ax_suction_gripper parent="gripper_base_link">
            <origin xyz="0.02 0 0" rpy="0 ${pi / 2} 0"/>
        </xacro:ax_suction_gripper>
    </xacro:if>

    <!-- tool selects the arm_rgbd mount (plate centre for suction, wrist otherwise). -->
    <xacro:ax_sensor_suite profile="ax1" robot_id="$(arg sensor_robot_id)" frame_prefix="${frames}"
                           tool="$(arg gripper_model)"/>

    <!-- 구동·상태는 ros2_control 하나로 처리한다. 바퀴 4개는 diff_drive_controller,
         팔 5축은 joint_trajectory_controller, primitive 손가락은 위치 그룹 제어기가 명령한다.
         제어기 이름·주기·바퀴 간격(0.622 m)·반경(0.19631 m)은 ax_control/config/ax1_controllers.yaml이 기준이다. -->
    <ros2_control name="${model_name}_gz_system" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
        <xacro:ax_velocity_joint name="front_left_wheel_joint"/>
        <xacro:ax_velocity_joint name="front_right_wheel_joint"/>
        <xacro:ax_velocity_joint name="rear_left_wheel_joint"/>
        <xacro:ax_velocity_joint name="rear_right_wheel_joint"/>
        <!-- 팔 위치 범위·속도·effort 상한은 각 joint의 limit을 따른다(effort는 토크 산정 전 미검증 값). -->
        <xacro:ax_position_joint name="column_yaw_joint"/>
        <xacro:ax_position_joint name="shoulder_joint"/>
        <xacro:ax_position_joint name="elbow_joint"/>
        <xacro:ax_position_joint name="wrist_joint"/>
        <xacro:ax_position_joint name="gripper_rotation_joint"/>
        <!-- 손가락 직선 관절(m)은 primitive 집게에만 있다. 다른 공구 관절은 구동하지 않는다. -->
        <xacro:if value="${use_primitive_gripper}">
            <xacro:ax_position_joint name="left_finger_joint"/>
            <xacro:ax_position_joint name="right_finger_joint"/>
        </xacro:if>
    </ros2_control>
    <xacro:ax_gz_ros2_control namespace="$(arg ros_namespace)" params_file="$(arg ros2_control_params)"/>
</robot>
