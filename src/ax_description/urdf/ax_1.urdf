--><joint name="gripper_rotation_joint" type="revolute"><parent link="wrist_link"/><child link="gripper_base_link"/><origin rpy="0 1.5707963267948966 0" xyz="0 0 -0.274"/><axis xyz="1 0 0"/><!-- AX v0.1 속도 제한 적용. 위치 범위 유지, effort는 토크 산정 전의 미검증 기존값. --><limit effort="5.0" lower="-3.14159" upper="3.14159" velocity="0.7"/><dynamics damping="1.0" friction="0.0"/></joint><!-- Base Link --><link name="epick_base_link"/><joint name="gripper_base_link_to_epick_base_link" type="fixed"><parent link="gripper_base_link"/><child link="epick_base_link"/><origin rpy="0 1.5707963267948966 0" xyz="0.02 0 0"/></joint><!-- EPick Body --><link name="epick_body"><!-- AX simulation mass assumption; upstream provides no product inertia. --><inertial><mass value="0.71"/><inertia ixx="0.0009628363249999999" ixy="0" ixz="0" iyy="0.0009628363249999999" iyz="0" izz="0.0006872799999999999"/></inertial><visual><!-- Shifted backwards since the mesh origin is at the base end --><origin rpy="0 0 0" xyz="0 0 -0.05115"/><geometry><mesh filename="package://epick_description/meshes/visual/epick_body.stl" scale="0.001 0.001 0.001"/></geometry><material name="epick_gray"><color rgba="0.25 0.25 0.25 1"/></material></visual><collision><origin rpy="0 0 0" xyz="0 0 0"/><geometry><cylinder length="0.1023" radius="0.044"/></geometry></collision></link><joint name="epick_base_link_to_epick_body" type="fixed"><parent link="epick_base_link"/><child link="epick_body"/><origin rpy="0 0 0" xyz="0 0 0.05115"/></joint><link name="epick_suction_cup"><visual><geometry><cylinder length="0.015" radius="0.012"/></geometry></visual><collision><geometry><cylinder length="0.015" radius="0.012"/></geometry></collision><inertial><mass value="0.04"/><inertia ixx="2.19e-06" ixy="0" ixz="0" iyy="2.19e-06" iyz="0" izz="2.88e-06"/></inertial></link><joint name="epick_cup_joint" type="fixed"><parent link="epick_body"/><child link="epick_suction_cup"/><origin xyz="0 0 0.05865"/></joint><link name="epick_tip"/><joint name="epick_tip_jo