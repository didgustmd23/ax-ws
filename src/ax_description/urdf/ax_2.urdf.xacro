<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_2">
  <xacro:arg name="robot_name" default="robot_2"/>
  <xacro:arg name="frame_prefix" default=""/>
  <xacro:arg name="sensor_robot_id" default="robot_2"/>
  <xacro:property name="model_name" value="$(arg robot_name)"/>
  <xacro:property name="frames" value="$(arg frame_prefix)"/>
  <xacro:include filename="ax_2_geometry.xacro"/>
  <xacro:include filename="ax_2_physical_properties.xacro"/>
  <xacro:include filename="sensors.xacro"/>
  <!-- CAD units mm; pivots are generated in m. +X forward, +Y left, +Z up.
       Independent virtual budgets: body 12 kg, shelf 5 kg, wheels 0.4 kg each.
       No arm, suction tool, ros2_control or cargo-state classifier is implied. -->
  <xacro:macro name="ax2_visual" params="file pivot">
    <visual>
      <origin xyz="${-pivot[0]} ${-pivot[1]} ${-pivot[2]}"/>
      <geometry>
        <mesh filename="package://ax_description/meshes/parts/AX_2/${file}.obj" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
  </xacro:macro>
  <link name="base_link">
    <xacro:ax2_visual file="ax_body" pivot="${ax2_ax_body_pivot}"/>
    <xacro:ax2_physics_base_link/>
  </link>
  <xacro:macro name="ax2_fixed_joint" params="name child pivot">
    <joint name="${name}" type="fixed">
      <parent link="base_link"/>
      <child link="${child}"/>
      <origin
          xyz="${pivot[0]-ax2_ax_body_pivot[0]} ${pivot[1]-ax2_ax_body_pivot[1]} ${pivot[2]-ax2_ax_body_pivot[2]}"/>
    </joint>
  </xacro:macro>
  <link name="shelf_link">
    <xacro:ax2_visual file="ax_shelf" pivot="${ax2_ax_shelf_pivot}"/>
    <xacro:ax2_physics_shelf_link/>
  </link>
  <xacro:ax2_fixed_joint name="shelf_joint" child="shelf_link" pivot="${ax2_ax_shelf_pivot}"/>
  <link name="front_trim_link">
    <xacro:ax2_visual file="ax_right" pivot="${ax2_ax_right_pivot}"/>
    <xacro:ax2_physics_front_trim_link/>
  </link>
  <xacro:ax2_fixed_joint name="front_trim_joint" child="front_trim_link" pivot="${ax2_ax_right_pivot}"/>
  <!-- The existing top_lidar mesh is retained as a housing. The configured
       navigation sensors are exactly the front/rear 180-degree pair below. -->
  <link name="top_lidar_housing_link">
    <xacro:ax2_visual file="ax_top_lidar" pivot="${ax2_ax_top_lidar_pivot}"/>
    <xacro:ax2_physics_top_lidar_housing_link/>
  </link>
  <xacro:ax2_fixed_joint
      name="top_lidar_housing_joint"
      child="top_lidar_housing_link"
      pivot="${ax2_ax_top_lidar_pivot}"/>
  <xacro:macro name="ax2_wheel" params="name file pivot">
    <link name="${name}_wheel">
      <visual>
        <origin xyz="${-pivot[0]} ${pivot[2]} ${-pivot[1]}" rpy="${pi/2} 0 0"/>
        <geometry>
          <mesh filename="package://ax_description/meshes/parts/AX_2/${file}.obj" scale="0.001 0.001 0.001"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${ax2_wheel_radius}" length="${ax2_wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${ax2_wheel_mass}"/>
        <inertia
            ixx="${ax2_wheel_mass*(3*ax2_wheel_radius**2+ax2_wheel_width**2)/12}"
            iyy="${ax2_wheel_mass*(3*ax2_wheel_radius**2+ax2_wheel_width**2)/12}"
            izz="${ax2_wheel_mass*ax2_wheel_radius**2/2}"
            ixy="0"
            ixz="0"
            iyz="0"/>
      </inertial>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel"/>
      <origin
          xyz="${pivot[0]-ax2_ax_body_pivot[0]} ${pivot[1]-ax2_ax_body_pivot[1]} ${pivot[2]-ax2_ax_body_pivot[2]}"
          rpy="${-pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>
  <xacro:ax2_wheel name="front_left" file="ax_tire_02" pivot="${ax2_ax_tire_02_pivot}"/>
  <xacro:ax2_wheel name="front_right" file="ax_tire_01" pivot="${ax2_ax_tire_01_pivot}"/>
  <xacro:ax2_wheel name="rear_left" file="ax_tire_04" pivot="${ax2_ax_tire_04_pivot}"/>
  <xacro:ax2_wheel name="rear_right" file="ax_tire_03" pivot="${ax2_ax_tire_03_pivot}"/>
  <xacro:ax_sensor_suite profile="ax2" robot_id="$(arg sensor_robot_id)" frame_prefix="${frames}"/>
  <!-- Development contact deck: 0.72 m square on the middle shelf, just above
       its padded collision surface. Raw contact is NOT an OCCUPIED verdict. -->
  <link name="cargo_contact_link">
    <visual>
      <geometry>
        <box size="0.72 0.72 0.002"/>
      </geometry>
      <material name="contact_pad">
        <color rgba="0.15 0.55 0.25 1"/>
      </material>
    </visual>
    <collision name="cargo_contact_collision">
      <geometry>
        <box size="0.72 0.72 0.002"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00216001666667" iyy="0.00216001666667" izz="0.00432" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="cargo_contact_joint" type="fixed">
    <parent link="shelf_link"/>
    <child link="cargo_contact_link"/>
    <origin xyz="0 0 ${1.2267-ax2_ax_shelf_pivot[2]}"/>
  </joint>
  <gazebo reference="cargo_contact_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="cargo_contact_link">
    <sensor name="cargo_contact" type="contact">
      <topic>/ax/$(arg sensor_robot_id)/sensors/cargo_contact</topic>
      <gz_frame_id>${frames}cargo_contact_link</gz_frame_id>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <!-- sdformat14 rewrites collision names during URDF fixed-link conversion.
           The integration test verifies this reference in the final SDF. -->
      <contact>
        <collision>cargo_contact_link_fixed_joint_lump__cargo_contact_collision_collision</collision>
        <!-- Harmonic Contact uses this nested topic for the actual publisher. -->
        <topic>/ax/$(arg sensor_robot_id)/sensors/cargo_contact</topic>
      </contact>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>${ax2_wheel_separation}</wheel_separation>
      <wheel_radius>${ax2_wheel_radius}</wheel_radius>
      <topic>/model/${model_name}/cmd_vel</topic>
      <odom_topic>/model/${model_name}/odometry</odom_topic>
      <tf_topic>/model/${model_name}/tf</tf_topic>
      <frame_id>${frames}odom</frame_id>
      <child_frame_id>${frames}base_link</child_frame_id>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/model/${model_name}/joint_states</topic>
    </plugin>
  </gazebo>
</robot>
