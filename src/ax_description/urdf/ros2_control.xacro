<?xml version="1.0"?>
<!-- ros2_control 하드웨어 인터페이스와 gz_ros2_control 플러그인 공통 매크로.
     이 파일의 플러그인이 바퀴·팔·손가락의 유일한 Gazebo 구동 주체다.
     Gazebo DiffDrive·JointPositionController·JointStatePublisher를 같은 관절에 함께 두지 않는다. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Four fixed wheel axes require lateral slip for skid steering. Local Z is
         the axle for every wheel; it stays fixed when the wheel rolls. These
         anisotropic friction values are simulation assumptions, not tire specs. -->
    <xacro:macro name="ax_wheel_contact" params="link">
        <gazebo reference="${link}">
            <mu1>0.1</mu1>
            <mu2>1.0</mu2>
            <fdir1>0 0 1</fdir1>
        </gazebo>
    </xacro:macro>

    <!-- 바퀴: 속도 명령(rad/s). 위치·속도 상태는 diff_drive_controller의 주행 거리 계산에 쓴다. -->
    <xacro:macro name="ax_velocity_joint" params="name">
        <joint name="${name}">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
    </xacro:macro>

    <!-- 팔·손가락: 위치 명령(회전 rad, 직선 m). gz_ros2_control 1.2.x는 위치 오차를
         Gazebo 관절 속도 명령으로 바꿔 적용하므로 URDF limit의 effort 상한이 그대로 걸린다.
         effort 상태는 Gazebo 관절 전달 렌치의 축 성분이며 토크 센서로 검증하지 않았다. -->
    <xacro:macro name="ax_position_joint" params="name">
        <joint name="${name}">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
    </xacro:macro>

    <!-- 모델당 controller_manager 하나를 namespace 아래에 만든다.
         제어기 설정 YAML은 A2 ax_control/config가 소유하며 launch가 절대 경로로 넘긴다
         (common_params_file: 모든 로봇 공통, params_file: 모델별).
         params_file이 비어 있으면(RViz 표시·정적 검사·제어 없는 시험) 플러그인을 생성하지 않는다. -->
    <xacro:macro name="ax_gz_ros2_control" params="namespace params_file common_params_file:=''">
        <xacro:if value="${params_file != ''}">
            <gazebo>
                <plugin filename="gz_ros2_control-system"
                        name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                    <xacro:if value="${common_params_file != ''}">
                        <parameters>${common_params_file}</parameters>
                    </xacro:if>
                    <parameters>${params_file}</parameters>
                    <!-- 제어기가 명령 인터페이스를 잡지 않은 관절에는 속도 0 명령을 준다(effort 상한 안에서 유지). -->
                    <hold_joints>true</hold_joints>
                    <!-- 위치 명령 → 목표 속도 = gain × controller_manager 주기(100 Hz) × 오차, 즉 10 s^-1. 플러그인 기본값과 같다. -->
                    <position_proportional_gain>0.1</position_proportional_gain>
                    <!-- 제어기 토픽 이름 변경은 launch의 spawner가 제어기별로 넘긴다. -->
                    <ros>
                        <namespace>${namespace}</namespace>
                        <remapping>/tf:=/tf</remapping>
                        <remapping>tf:=/tf</remapping>
                        <remapping>tf_static:=/tf_static</remapping>
                    </ros>
                </plugin>
            </gazebo>
        </xacro:if>
    </xacro:macro>

    <!-- A2 흡착 부착·해제 Gazebo 플러그인(ax_control의 ax_suction_attach_system).
         Gazebo가 고정 관절을 합치므로 epick_tcp 대신 gripper_base_link를 부모로 두고 TCP까지 거리(tcp_offset, m)를 넘긴다.
         max_attach_distance(m)는 계약에 값이 없어 개발용으로 정한 잠정값이다.
         진공·접촉 물리는 없으며 조건을 만족하면 고정 관절로 잇는다. 라이브러리 경로는 ax_control launch가 설정한다. -->
    <xacro:macro name="ax_tool_attach" params="namespace tcp_offset max_attach_distance:=0.12">
        <gazebo>
            <plugin filename="ax_suction_attach_system" name="ax_control::SuctionAttachSystem">
                <parent_link>gripper_base_link</parent_link>
                <tcp_offset>${tcp_offset} 0 0</tcp_offset>
                <max_attach_distance>${max_attach_distance}</max_attach_distance>
                <command_topic>${namespace}/tool/gz_command</command_topic>
                <state_topic>${namespace}/tool/gz_state</state_topic>
            </plugin>
        </gazebo>
    </xacro:macro>
</robot>
