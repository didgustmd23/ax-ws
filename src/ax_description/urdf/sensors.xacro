<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Ideal development sensors. Rendering / IMU / contact systems are loaded
       once by the world; these macros only attach model-local sensor entities. -->
  <xacro:macro name="ax_sensor_body" params="name parent xyz rpy mass sx sy sz">
    <link name="${name}_link">
      <visual>
        <geometry>
          <box size="${sx} ${sy} ${sz}"/>
        </geometry>
        <material name="${name}_dark">
          <color rgba="0.08 0.10 0.14 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="${sx} ${sy} ${sz}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${mass}"/>
        <inertia
            ixx="${mass*(sy*sy+sz*sz)/12}"
            iyy="${mass*(sx*sx+sz*sz)/12}"
            izz="${mass*(sx*sx+sy*sy)/12}"
            ixy="0"
            ixz="0"
            iyz="0"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>
  <!-- 2D LiDAR: 링크 +X 기준 ±90°(전방 180°)를 수평면에서 스캔한다. -->
  <xacro:macro name="ax_lidar" params="name xyz rpy topic_prefix frame_prefix">
    <xacro:ax_sensor_body
        name="${name}"
        parent="base_link"
        xyz="${xyz}"
        rpy="${rpy}"
        mass="0.2"
        sx="0.06"
        sy="0.06"
        sz="0.04"/>
    <gazebo reference="${name}_link">
      <sensor name="${name}" type="gpu_lidar">
        <topic>${topic_prefix}/${name}/scan</topic>
        <gz_frame_id>${frame_prefix}${name}_link</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>181</samples>
              <resolution>1</resolution>
              <min_angle>${-pi/2}</min_angle>
              <max_angle>${pi/2}</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>10</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>
  <!-- 근거리 ToF 근사: 링크 +X 한 방향의 단일 광선(gpu_lidar 1샘플)이다. 특정 실물 ToF의
       정확도·재질 응답·다중 경로 오차를 재현하지 않는다. 범위 밖·무효 값은 Gazebo가 inf로
       내보내며 0이나 접촉 성공으로 바꾸지 않는다. ROS에는 원시 inf를 보존하는 1빔
       sensor_msgs/msg/LaserScan(ranges[0], 단위 m, 센서 원점 기준)으로 전달한다. 설치된
       ros_gz_bridge의 LaserScan->Range 변환은 +inf를 max_range + 1(현재 1.5 m)이라는 범위 밖
       유한값으로 바꾸므로 쓰지 않는다. -->
  <xacro:macro name="ax_tof" params="name parent xyz rpy min_range max_range topic_prefix frame_prefix">
    <!-- 0.012 m(측정 방향) x 0.02 x 0.02 m, 0.01 kg 개발용 외형 -->
    <xacro:ax_sensor_body
        name="${name}"
        parent="${parent}"
        xyz="${xyz}"
        rpy="${rpy}"
        mass="0.01"
        sx="0.012"
        sy="0.02"
        sz="0.02"/>
    <gazebo reference="${name}_link">
      <sensor name="${name}" type="gpu_lidar">
        <topic>${topic_prefix}/${name}/scan</topic>
        <gz_frame_id>${frame_prefix}${name}_link</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>${min_range}</min>
            <max>${max_range}</max>
            <resolution>0.001</resolution>
          </range>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>
  <xacro:macro name="ax_camera" params="name parent xyz rpy depth topic_prefix frame_prefix">
    <xacro:ax_sensor_body
        name="${name}"
        parent="${parent}"
        xyz="${xyz}"
        rpy="${rpy}"
        mass="0.15"
        sx="0.05"
        sy="0.06"
        sz="0.04"/>
    <link name="${name}_optical_frame"/>
    <joint name="${name}_optical_joint" type="fixed">
      <parent link="${name}_link"/>
      <child link="${name}_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>
    <gazebo reference="${name}_link">
      <sensor name="${name}" type="${'rgbd_camera' if depth else 'camera'}">
        <topic>${topic_prefix}/${name}${'' if depth else '/image_raw'}</topic>
        <gz_frame_id>${frame_prefix}${name}_optical_frame</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <camera>
          <optical_frame_id>${frame_prefix}${name}_optical_frame</optical_frame_id>
          <camera_info_topic>${topic_prefix}/${name}/camera_info</camera_info_topic>
          <horizontal_fov>${pi/3}</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>10</far>
          </clip>
          <xacro:if value="${depth}">
            <depth_camera>
              <clip>
                <near>0.05</near>
                <far>5</far>
              </clip>
            </depth_camera>
          </xacro:if>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>
  <!-- tool: gripper_model of the AX_1 arm. Only the suction tool has suction_base_link,
       so the plate-centre RGB-D mount is used there and the wrist mount otherwise. -->
  <xacro:macro name="ax_sensor_suite" params="profile robot_id frame_prefix tool:=none">
    <xacro:property name="mounts" value="${xacro.load_yaml('../config/sensor_mounts.yaml')[profile]}"/>
    <xacro:property name="topics" value="${'/ax/' + robot_id + '/sensors'}"/>
    <!-- 몸체 전방: 카메라(front_rgb, +Y)–LiDAR(중앙)–카메라(front_rgbd, -Y)를
         같은 높이에 둔다. 좌표는 base_link 기준 m, 모두 로봇 +X를 향한다. -->
    <xacro:ax_lidar
        name="front_lidar"
        xyz="${mounts['front_lidar']['xyz']}"
        rpy="${mounts['front_lidar']['rpy']}"
        topic_prefix="${topics}"
        frame_prefix="${frame_prefix}"/>
    <xacro:ax_lidar
        name="rear_lidar"
        xyz="${mounts['rear_lidar']['xyz']}"
        rpy="${mounts['rear_lidar']['rpy']}"
        topic_prefix="${topics}"
        frame_prefix="${frame_prefix}"/>
    <xacro:ax_camera
        name="front_rgbd"
        parent="base_link"
        depth="${True}"
        xyz="${mounts['front_rgbd']['xyz']}"
        rpy="${mounts['front_rgbd']['rpy']}"
        topic_prefix="${topics}"
        frame_prefix="${frame_prefix}"/>
    <xacro:ax_camera
        name="front_rgb"
        parent="base_link"
        depth="${False}"
        xyz="${mounts['front_rgb']['xyz']}"
        rpy="${mounts['front_rgb']['rpy']}"
        topic_prefix="${topics}"
        frame_prefix="${frame_prefix}"/>
    <xacro:ax_sensor_body
        name="imu"
        parent="base_link"
        xyz="${mounts['imu']['xyz']}"
        rpy="${mounts['imu']['rpy']}"
        mass="0.05"
        sx="0.035"
        sy="0.025"
        sz="0.015"/>
    <gazebo reference="imu_link">
      <sensor name="imu" type="imu">
        <topic>${topics}/imu</topic>
        <gz_frame_id>${frame_prefix}imu_link</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <imu/>
      </sensor>
    </gazebo>
    <xacro:if value="${profile == 'ax1'}">
      <!-- 팔 카메라의 부모 링크와 좌표는 sensor_mounts.yaml에서 함께 읽는다.
           xyz/rpy는 해당 부모 링크 좌표계 기준이므로 부모만 바꿔 재사용하지 않는다. -->
      <!-- arm_rgbd: 모든 공구에서 wrist_link 바깥쪽(+Y)에 둔다. suction은 흡착판 바깥의
           상자 윗면을 비스듬히 보는 별도 좌표, 다른 공구는 기존 손목 좌표를 쓴다.
           접근 전 물체 표면·높이·주변 형상 관찰용이며 최종 접근 거리는 suction_tof가 맡는다. -->
      <xacro:property name="rgbd_mount"
                      value="${mounts['arm_rgbd'] if tool == 'suction' else mounts['arm_rgbd_non_suction']}"/>
      <xacro:ax_camera
          name="arm_rgbd"
          parent="${rgbd_mount['parent']}"
          depth="${True}"
          xyz="${rgbd_mount['xyz']}"
          rpy="${rgbd_mount['rpy']}"
          topic_prefix="${topics}"
          frame_prefix="${frame_prefix}"/>
      <!-- suction_tof: 흡착 공구에서만 4컵 중앙에 생성하고 말단 회전과 함께 돈다.
           최종 접근 간격 = 측정 거리 - lip_offset(센서 원점에서 컵 끝면까지). -->
      <xacro:if value="${tool == 'suction'}">
        <xacro:ax_tof
            name="suction_tof"
            parent="${mounts['suction_tof']['parent']}"
            xyz="${mounts['suction_tof']['xyz']}"
            rpy="${mounts['suction_tof']['rpy']}"
            min_range="${mounts['suction_tof']['min_range']}"
            max_range="${mounts['suction_tof']['max_range']}"
            topic_prefix="${topics}"
            frame_prefix="${frame_prefix}"/>
      </xacro:if>
      <!-- arm_rgb: upper_arm_link. 공구 말단·물체 접촉 장면을 관찰하는 영상이며
           흡착·접촉 성공 판정 센서가 아니다. -->
      <xacro:ax_camera
          name="arm_rgb"
          parent="${mounts['arm_rgb']['parent']}"
          depth="${False}"
          xyz="${mounts['arm_rgb']['xyz']}"
          rpy="${mounts['arm_rgb']['rpy']}"
          topic_prefix="${topics}"
          frame_prefix="${frame_prefix}"/>
    </xacro:if>
  </xacro:macro>
</robot>
