<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- AX-designed virtual tools for model/kinematic comparison, not rated hardware. -->
    <!-- Both tools use local +Z as the approach direction and local X for jaw opening. -->
    <xacro:macro name="ax_gripper_box" params="name mass sx sy sz cz color">
        <link name="${name}">
            <visual>
                <origin xyz="0 0 ${cz}"/>
                <geometry><box size="${sx} ${sy} ${sz}"/></geometry>
                <material name="${name}_color"><color rgba="${color}"/></material>
            </visual>
            <xacro:box_collision length="${sx}" width="${sy}" height="${sz}"
                                 cx="0" cy="0" cz="${cz}"/>
            <xacro:box_inertial mass="${mass}" length="${sx}" width="${sy}" height="${sz}"
                                cx="0" cy="0" cz="${cz}"/>
        </link>
    </xacro:macro>

    <xacro:macro name="ax_parallel_wide_gripper" params="parent *origin">
        <!-- Inner jaw gap = 0.020 + 2*q meters, q in [0, 0.215]. -->
        <xacro:ax_gripper_box name="wide_gripper_base_link" mass="0.8"
                              sx="0.50" sy="0.10" sz="0.05" cz="0.025"
                              color="0.05 0.55 0.60 1"/>
        <joint name="wide_gripper_mount_joint" type="fixed">
            <parent link="${parent}"/><child link="wide_gripper_base_link"/>
            <xacro:insert_block name="origin"/>
        </joint>
        <xacro:ax_gripper_box name="wide_left_finger_link" mass="0.25"
                              sx="0.02" sy="0.10" sz="0.22" cz="0.16"
                              color="0.18 0.22 0.27 1"/>
        <xacro:ax_gripper_box name="wide_right_finger_link" mass="0.25"
                              sx="0.02" sy="0.10" sz="0.22" cz="0.16"
                              color="0.18 0.22 0.27 1"/>
        <joint name="wide_left_finger_joint" type="prismatic">
            <parent link="wide_gripper_base_link"/><child link="wide_left_finger_link"/>
            <origin xyz="0.02 0 0"/><axis xyz="1 0 0"/>
            <limit lower="0" upper="0.215" effort="100" velocity="0.05"/>
        </joint>
        <joint name="wide_right_finger_joint" type="prismatic">
            <parent link="wide_gripper_base_link"/><child link="wide_right_finger_link"/>
            <origin xyz="-0.02 0 0"/><axis xyz="-1 0 0"/>
            <limit lower="0" upper="0.215" effort="100" velocity="0.05"/>
            <mimic joint="wide_left_finger_joint" multiplier="1"/>
        </joint>
        <link name="wide_grasp_frame"/>
        <joint name="wide_grasp_frame_joint" type="fixed">
            <parent link="wide_gripper_base_link"/><child link="wide_grasp_frame"/>
            <origin xyz="0 0 0.16"/>
        </joint>
    </xacro:macro>

    <xacro:macro name="ax_suction_cup" params="name x y">
        <link name="${name}">
            <visual>
                <origin xyz="0 0 0.0125"/>
                <geometry><cylinder radius="0.012" length="0.025"/></geometry>
                <material name="${name}_neck"><color rgba="0.6 0.65 0.7 1"/></material>
            </visual>
            <visual>
                <origin xyz="0 0 0.031"/>
                <geometry><cylinder radius="0.025" length="0.012"/></geometry>
                <material name="${name}_rubber"><color rgba="0.15 0.30 0.85 1"/></material>
            </visual>
            <!-- Cylinder envelope is only an approximation of a compliant suction cup. -->
            <collision>
                <origin xyz="0 0 0.0185"/>
                <geometry><cylinder radius="0.025" length="0.037"/></geometry>
            </collision>
            <inertial>
                <origin xyz="0 0 0.0185"/>
                <mass value="0.04"/>
                <inertia ixx="${0.04 / 12 * (3 * 0.025**2 + 0.037**2)}"
                         iyy="${0.04 / 12 * (3 * 0.025**2 + 0.037**2)}"
                         izz="${0.5 * 0.04 * 0.025**2}" ixy="0" ixz="0" iyz="0"/>
            </inertial>
        </link>
        <joint name="${name}_joint" type="fixed">
            <parent link="suction_base_link"/><child link="${name}"/>
            <origin xyz="${x} ${y} 0.025"/>
        </joint>
    </xacro:macro>

    <xacro:macro name="ax_suction_gripper" params="parent *origin">
        <xacro:ax_gripper_box name="suction_base_link" mass="0.4"
                              sx="0.18" sy="0.14" sz="0.025" cz="0.0125"
                              color="0.85 0.88 0.92 1"/>
        <joint name="suction_mount_joint" type="fixed">
            <parent link="${parent}"/><child link="suction_base_link"/>
            <xacro:insert_block name="origin"/>
        </joint>
        <xacro:ax_suction_cup name="suction_cup_1_link" x="0.055" y="0.04"/>
        <xacro:ax_suction_cup name="suction_cup_2_link" x="0.055" y="-0.04"/>
        <xacro:ax_suction_cup name="suction_cup_3_link" x="-0.055" y="0.04"/>
        <xacro:ax_suction_cup name="suction_cup_4_link" x="-0.055" y="-0.04"/>
        <link name="suction_grasp_frame"/>
        <joint name="suction_grasp_frame_joint" type="fixed">
            <parent link="suction_base_link"/><child link="suction_grasp_frame"/>
            <origin xyz="0 0 0.062"/>
        </joint>
        <!-- No vacuum force, contact detection, or attach/detach implementation in this model. -->
    </xacro:macro>
</robot>
