<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.8">
  <!-- 공통 시험 월드: 로봇은 launch에서 생성한다. 원점 주변은 빈 주행 구역, x=8 쪽은 작업 구역이다. -->
    <world name="ax_test">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact" />
    <!-- 물리 적분 간격 0.001 s와 목표 실시간 배율 1.0. 실제 처리 속도는 PC 성능과 센서 부하에 따라 달라진다. -->
    <physics name="drive_test_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.80665</gravity>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <!-- 30×30 m 바닥. 주행 구역에 숨겨진 벽이나 고정 장애물은 배치하지 않는다. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- 집기 시험 작업대: 중심 (8, 3), 높이 0.8 m. 초기 로봇 위치에서 이곳으로 자동 이동하지는 않는다. -->
    <model name="station_src">
      <static>true</static>
      <pose>8 3 0.4 0 0 0</pose>
      <link name="table">
        <collision name="table_collision">
          <geometry>
            <box>
              <size>1.0 1.0 0.8</size>
            </box>
          </geometry>
        </collision>
        <visual name="table_visual">
          <geometry>
            <box>
              <size>1.0 1.0 0.8</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.3 0.4 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- 배치 시험 작업대: 중심 (8, -3), 높이 0.8 m. -->
    <model name="station_dst">
      <static>true</static>
      <pose>8 -3 0.4 0 0 0</pose>
      <link name="table">
        <collision name="table_collision">
          <geometry>
            <box>
              <size>1.0 1.0 0.8</size>
            </box>
          </geometry>
        </collision>
        <visual name="table_visual">
          <geometry>
            <box>
              <size>1.0 1.0 0.8</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.5 0.4 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- 0.2 m 정육면체, 0.5 kg. 초기 바닥면을 작업대보다 0.01 m 높여 시작 시 관통을 피한다. -->
    <model name="test_box">
      <pose>8 3 0.91 0 0 0</pose>
      <link name="box">
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.003333333333</ixx>
            <iyy>0.003333333333</iyy>
            <izz>0.003333333333</izz>
          </inertia>
        </inertial>
        <collision name="box_collision">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="box_visual">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.9 0.45 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>