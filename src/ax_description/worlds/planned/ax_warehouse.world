            <!--주변광에 반응하는 색 R G B A. 각 성분은 보통 0~1이고 A는 불투명도다.-->
            <ambient>0.600000024 0.660000026 0.720000029 1</ambient>
            <!--확산광에 반응하는 색 R G B A.-->
            <diffuse>0.600000024 0.660000026 0.720000029 1</diffuse>
