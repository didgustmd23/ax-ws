            <diffuse>0.24 0.30 0.35 1</diffuse>
          </material>
          <cast_shadows>false</cast_shadows>
        </visual>
      </link>
    </model>
    <!--Short single-robot test passage: X=3.0..4.9, Y=3.5..5.0, clear width 1.9 m. It is not a two-robot passing lane.-->
    <model name="rack_narrow">
      <static>true</static>
      <pose>5.4 4.25 0.9 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry>
            <box>
              <size>1 1.5 1.8</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1 1.5 1.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.24 0.30 0.35 1</ambient>
            <diffuse>0.24 0.30 0.35 1</diffuse>
          </material>
          <cast_shadows>false</cast_shadows>
        </visual>
      </link>
    </model>
    <!--Visual-only floor zones: no collision or invisible robot restrictions. Source/destination table heights remain 0.8 m.-->
    <model name="zone_inbound">
      <static>true</static>
      <pose>8 3 0.002 0 0 0</pose>
      <link name="marking">
        <visual name="marking">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>3 2</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.24 0.55 0.32 1</ambient>
            <diffuse>0.24 0.55 0.32 1</diffuse>
          </material>
          <cast_shadows>false</cast_shadows>
        </visual>
      </link>
    </model>
    <model name="zone_storage">
      <static>true</static>
      <pose>8 -3 0.002 0 0 0</pose>
      <link name="marking">
        <visual name="marking">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>3 2</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.70 0.48 0.22 1</ambient>
            <diffuse>0.70 0.48 0.22 1</diffuse>
          </material>
          <cast_shadows>false</cast_shadows>
        </visual>
      </link>
    </model>
    <model name="zone_handoff">
      <static>true</static>
      <pose>7 0 0.002 0 0 0</pose>
      <link name="marking">
        <visual name="marking">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>4 2.5</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.27 0.49 0.68 1</ambient>
            <diffuse>0.27 0.49 0.68 1</diffuse>
          </material>
          <cast_shadows>false</cast_shadows>
        </visual>
      </link>
    </model>
    <model name="zone_wait_robot_1">
      <static>true</static>
      <pose>0 -5.5 0.002 0 0 0</pose>
      <link name="marking">
        <visual name="marking">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>2.2 2.2</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.31 0.42 0.64 1</ambient>
            <diffuse>0.31 0.42 0.64 1</diffuse>
          </material>
          <cast_shadows>false</cast_shadows>
