              <size>0.22 0.20000000000000001 0.20000000000000001</size>
            </box>
          </geometry>
          <!--충돌 표면의 마찰·반발·접촉 설정. 비어 있는 세부 항목은 엔진 기본값을 사용한다.-->
          <surface>
