          <!--강체 질량(kg). 동적 샘플 상자의 값은 시험용 가정이며 실측 적재 중량이 아니다.-->
          <mass>2.0</mass>
          <!--회전 운동 계산용 관성 텐서(kg·m²). 질량 중심 좌표계 기준이다.-->
          <inertia>
            <!--X축 주위 관성 모멘트(kg·m²).-->
            <ixx>0.09708333333333334</ixx>
            <!--Y축 주위 관성 모멘트(kg·m²).-->
            <iyy>0.09708333333333334</iyy>
            <!--Z축 주위 관성 모멘트(kg·m²).-->
            <izz>0.053333333333333344</izz>
            <!--관성 텐서 XY 비대각 성분(kg·m²). 축에 정렬된 직육면체는 0이다.-->
            <ixy>0</ixy>
            <!--관성 텐서 XZ 비대각 성분(kg·m²).-->
            <ixz>0</ixz>
            <!--관성 텐서 YZ 비대각 성분(kg·m²).-->
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <!--물리 충돌·접촉 계산에 쓰는 형상. 화면에 보이는 visual과 역할이 다르다.-->
        <collision name="collision">
          <!--충돌체 또는 시각 외형의 기하학적 모양.-->
          <geometry>
            <!--직육면체 형상. size에서 세 축의 길이를 지정한다.-->
            <box>
              <!--직육면체의 X길이 Y길이 Z높이(m). pose는 모서리가 아닌 중심 위치다.-->
              <size>0.4 0.4 0.65</size>
            </box>
          </geometry>
        </collision>
        <!--화면과 카메라에 보이는 외형. 이 항목만으로 물리 충돌이 생기지는 않는다.-->
        <visual name="visual">
          <!--충돌체 또는 시각 외형의 기하학적 모양.-->
          <geometry>
            <!--직육면체 형상. size에서 세 축의 길이를 지정한다.-->
            <box>
              <!--직육면체의 X길이 Y길이 Z높이(m). pose는 모서리가 아닌 중심 위치다.-->
              <size>0.4 0.4 0.65</size>
            </box>
          </geometry>
          <!--물체 표시 색상과 조명 반응. 색상으로 크기 적합 샘플을 구분한다.-->
          <material>
            <!--주변광에 반응하는 색 R G B A. 각 성분은 보통 0~1이고 A는 불투명도다.-->
            <ambient>0.85 0.16 0.12 1</ambient>
            <!--확산광에 반응하는 색 R G B A.-->
            <diffuse>0.85 0.16 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
