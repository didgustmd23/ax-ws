            <!--Y축 주위 관성 모멘트(kg·m²).-->
            <iyy>0.00189</iyy>
            <!--Z축 주위 관성 모멘트(kg·m²).-->
            <izz>0.00189</izz>
            <!--관성 텐서 XY 비대각 성분(kg·m²). 축에 정렬된 직육면체는 0이다.-->
