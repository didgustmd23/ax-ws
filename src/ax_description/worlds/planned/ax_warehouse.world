<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.8">
  <!--두 창고 운반 시험 환경. X는 동서, Y는 남북, Z는 높이이며 길이=m, 질량=kg, 각도=rad이다. 로봇은 launch에서 별도로 생성한다.-->
  <world name="ax_test">
    <!--Gazebo 시스템 플러그인: 물리 운동과 충돌 계산.-->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <!--Gazebo 시스템 플러그인: GUI·서비스로 물체 생성·삭제·위치 변경.-->
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <!--Gazebo 시스템 플러그인: 월드의 물체와 자세를 GUI로 전달.-->
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <!--Gazebo 시스템 플러그인: 카메라·LiDAR 등 렌더링 센서 실행.-->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <!--깊이 카메라 등 렌더링 센서가 사용하는 그래픽 엔진.-->
      <render_engine>ogre2</render_engine>
    </plugin>
    <!--Gazebo 시스템 플러그인: IMU 측정값 생성.-->
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <!--Gazebo 시스템 플러그인: 상자와 적재판 등의 접촉 센서 실행.-->
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact" />
    <!--물리 계산 간격과 실시간 실행 비율. 개별 물체의 질량·충돌 형상과 함께 접촉을 계산한다.-->
    <physics name="warehouse_test_physics" type="ode">
      <!--물리 계산 한 단계의 시뮬레이션 시간(s).-->
      <max_step_size>0.001</max_step_size>
      <!--목표 시뮬레이션 시간 / 실제 경과 시간. 1이면 실제 시간과 같은 속도를 목표로 한다.-->
      <real_time_factor>1.0</real_time_factor>
      <!--물리 갱신의 목표 빈도(Hz). 실제 처리 속도는 PC 성능에 따라 달라진다.-->
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <!--월드 XYZ 방향 중력 가속도(m/s²). 음의 Z가 아래 방향이다.-->
    <gravity>0 0 -9.80665</gravity>
    <!--전체 창고를 비추는 조명. directional은 일정한 방향에서 오는 빛이다.-->
    <light name="sun" type="directional">
      <!--월드 기준 위치·회전: x y z roll pitch yaw. 앞 세 값은 m, 뒤 세 값은 rad.-->
      <pose>0 0 10 0 0 0</pose>
      <!--확산광에 반응하는 색 R G B A.-->
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <!--조명이 표면에 반사되어 생기는 하이라이트 색 R G B A.-->
      <specular>0.2 0.2 0.2 1</specular>
      <!--방향성 조명이 비추는 XYZ 방향 벡터.-->
      <direction>-0.5 0.1 -0.9</direction>
      <!--이 물체 또는 조명이 그림자를 만드는지 지정한다.-->
      <cast_shadows>false</cast_shadows>
    </light>
    <!--관찰 화면의 기본 밝기·배경색·그림자 설정.-->
    <scene>
      <!--주변광에 반응하는 색 R G B A. 각 성분은 보통 0~1이고 A는 불투명도다.-->
      <ambient>0.65 0.65 0.65 1</ambient>
      <!--물체가 없는 화면 영역의 배경색 R G B A.-->
      <background>0.8 0.85 0.9 1</background>
      <!--화면에서 그림자 렌더링을 사용할지 지정한다.-->
      <shadows>false</shadows>
    </scene>
    <!--floor_source: 출발 창고 바닥 / 윗면 Z=0m. 중심 XYZ=(-13 0 -0.05)m, 상자 형상 XYZ 크기=18 × 16 × 0.1m.-->
    <model name="floor_source">
      <!--true=바닥·벽·선반처럼 움직이지 않음, false=중력과 충돌로 움직이는 상자.-->
      <static>true</static>
      <!--월드 기준 위치·회전: x y z roll pitch yaw. 앞 세 값은 m, 뒤 세 값은 rad.-->
      <pose>-13 0 -0.050000000000000003 0 0 0</pose>
      <!--물체를 구성하는 하나의 강체. 아래에 충돌 형상·외형·질량을 정의한다.-->
      <link name="body">
        <!--물리 충돌·접촉 계산에 쓰는 형상. 화면에 보이는 visual과 역할이 다르다.-->
        <collision name="collision">
          <!--충돌체 또는 시각 외형의 기하학적 모양.-->
          <geometry>
            <!--직육면체 형상. size에서 세 축의 길이를 지정한다.-->
            <box>
              <!--직육면체의 X길이 Y길이 Z높이(m). pose는 모서리가 아닌 중심 위치다.-->
              <size>18 16 0.10000000000000001</size>
            </box>
          </geometry>
          <!--충돌 표면의 마찰·반발·접촉 설정. 비어 있는 세부 항목은 엔진 기본값을 사용한다.-->
          <surface>
            <!--바닥·상자·로봇 사이 미끄러짐에 영향을 주는 마찰 설정.-->
            <friction>
              <!--ODE 형식의 표면 설정. 여기서 값이 없으면 해당 기본 설정을 사용한다.-->
              <ode />
            </friction>
            <!--충돌 후 튀어 오르는 정도를 정하는 반발 설정. 비어 있으면 기본값.-->
            <bounce />
            <!--충돌 접촉 계산 옵션. 비어 있으면 기본값.-->
            <contact />
          </surface>
        </collision>
        <!--화면과 카메라에 보이는 외형. 이 항목만으로 물리 충돌이 생기지는 않는다.-->
        <visual name="visual">
          <!--충돌체 또는 시각 외형의 기하학적 모양.-->
          <geometry>
            <!--직육면체 형상. size에서 세 축의 길이를 지정한다.-->
            <box>
              <!--직육면체의 X길이 Y길이 Z높이(m). pose는 모서리가 아닌 중심 위치다.-->
              <size>18 16 0.10000000000000001</size>
            </box>
          </geometry>
          <!--물체 표시 색상과 조명 반응. 색상으로 크기 적합 샘플을 구분한다.-->
          <material>
            <!--주변광에 반응하는 색 R G B A. 각 성분은 보통 0~1이고 A는 불투명도다.-->
            <ambient>0.419999987 0.460000008 0.49000001 1</ambient>
            <!--확산광에 반응하는 색 R G B A.-->
            <diffuse>0.419999987 0.460000008 0.49000001 1</diffuse>
          </material>
          <!--이 물체 또는 조명이 그림자를 만드는지 지정한다.-->
          <cast_shadows>false</cast_shadows>
        </visual>
        <!--모델 기준 위치·회전: x y z roll pitch yaw. 앞 세 값은 m, 뒤 세 값은 rad.-->
        <pose>0 0 0 0 0 0</pose>
        <!--질량·무게중심·관성 텐서. static 물체의 값은 월드 저장 시 보존된 기본값일 수 있다.-->
        <inertial>
          <!--링크의 질량 중심 기준 위치·회전: x y z roll pitch yaw. 앞 세 값은 m, 뒤 세 값은 rad.-->
          <pose>0 0 0 0 0 0</pose>
          <!--강체 질량(kg). 동적 샘플 상자의 값은 시험용 가정이며 실측 적재 중량이 아니다.-->
          <mass>1</mass>
          <!--회전 운동 계산용 관성 텐서(kg·m²). 질량 중심 좌표계 기준이다.-->
          <inertia>
            <!--X축 주위 관성 모멘트(kg·m²).-->
            <ixx>1</ixx>
            <!--관성 텐서 XY 비대각 성분(kg·m²). 축에 정렬된 직육면체는 0이다.-->
            <ixy>0</ixy>
            <!--관성 텐서 XZ 비대각 성분(kg·m²).-->
            <ixz>0</ixz>
            <!--Y축 주위 관성 모멘트(kg·m²).-->
            <iyy>1</iyy>
            <!--관성 텐서 YZ 비대각 성분(kg·m²).-->
            <iyz>0</iyz>
            <!--Z축 주위 관성 모멘트(kg·m²).-->
            <izz>1</izz>
          </inertia>
        </inertial>
        <!--이 강체에 바람 효과를 적용할지 지정한다.-->
        <enable_wind>false</enable_wind>
      </link>
      <!--같은 모델 안의 강체끼리 충돌을 계산할지 지정한다.-->
      <self_collide>false</self_collide>
    </model>
    <!--wall_source_north: 창고 외곽 벽 / 출발 창고 / north=북쪽, south=남쪽, outer=바깥쪽 끝. 중심 XYZ=(-13 8.1 1.25)m, 상자 형상 XYZ 크기=18.4 × 0.2 × 2.5m.-->
    <model name="wall_source_north">
      <!--true=바닥·벽·선반처럼 움직이지 않음, false=중력과 충돌로 움직이는 상자.-->
      <static>true</static>
      <!--월드 기준 위치·회전: x y z roll pitch yaw. 앞 세 값은 m, 뒤 세 값은 rad.-->
      <pose>-13 8.0999999999999996 1.25 0 0 0</pose>
      <!--물체를 구성하는 하나의 강체. 아래에 충돌 형상·외형·질량을 정의한다.-->
      <link name="body">
        <!--물리 충돌·접촉 계산에 쓰는 형상. 화면에 보이는 visual과 역할이 다르다.-->
        <collision name="collision">
          <!--충돌체 또는 시각 외형의 기하학적 모양.-->
          <geometry>
            <!--직육면체 형상. size에서 세 축의 길이를 지정한다.-->
            <box>
              <!--직육면체의 X길이 Y길이 Z높이(m). pose는 모서리가 아닌 중심 위치다.-->
              <size>18.399999999999999 0.20000000000000001 2.5</size>
            </box>
          </geometry>
          <!--충돌 표면의 마찰·반발·접촉 설정. 비어 있는 세부 항목은 엔진 기본값을 사용한다.-->
          <surface>
            <!--바닥·상자·로봇 사이 미끄러짐에 영향을 주는 마찰 설정.-->
            <friction>
              <!--ODE 형식의 표면 설정. 여기서 값이 없으면 해당 기본 설정을 사용한다.-->
              <ode />
            </friction>
            <!--충돌 후 튀어 오르는 정도를 정하는 반발 설정. 비어 있으면 기본값.-->
            <bounce />
            <!--충돌 접촉 계산 옵션. 비어 있으면 기본값.-->
            <contact />
          </surface>
        </collision>
        <!--화면과 카메라에 보이는 외형. 이 항목만으로 물리 충돌이 생기지는 않는다.-->
        <visual name="visual">
          <!--충돌체 또는 시각 외형의 기하학적 모양.-->
          <geometry>
            <!--직육면체 형상. size에서 세 축의 길이를 지정한다.-->
            <box>
              <!--직육면체의 X길이 Y길이 Z높이(m). pose는 모서리가 아닌 중심 위치다.-->
              <size>18.399999999999999 0.20000000000000001 2.5</size>
            </box>
          </geometry>
          <!--물체 표시 색상과 조명 반응. 색상으로 크기 적합 샘플을 구분한다.-->
          <material>
            <!--주변광에 반응하는 색 R G B A. 각 성분은 보통 0~1이고 A는 불투명도다.-->
            <ambient>0.600000024 0.660000026 0.720000029 1</ambient>
            <!--확산광에 반응하는 색 R G B A.-->
            <diffuse>0.600000024 0.660000026 0.720000029 1</diffuse>
          </material>
          <!--이 물체 또는 조명이 그림자를 만드는지 지정한다.-->
          <cast_shadows>false</cast_shadows>
        </visual>
        <!--모델 기준 위치·회전: x y z roll pitch yaw. 앞 세 값은 m, 뒤 세 값은 rad.-->
        <pose>0 0 0 0 0 0</pose>
        <!--질량·무게중심·관성 텐서. static 물체의 값은 월드 저장 시 보존된 기본값일 수 있다.-->
        <inertial>
          <!--링크의 질량 중심 기준 위치·회전: x y z roll pitch yaw. 앞 세 값은 m, 뒤 세 값은 rad.-->
          <pose>0 0 0 0 0 0</pose>
          <!--강체 질량(kg). 동적 샘플 상자의 값은 시험용 가정이며 실측 적재 중량이 아니다.-->
          <mass>1</mass>
          <!--회전 운동 계산용 관성 텐서(kg·m²). 질량 중심 좌표계 기준이다.-->
          <inertia>
            <!--X축 주위 관성 모멘트(kg·m²).-->
            <ixx>1</ixx>
            <!--관성 텐서 XY 비대각 성분(kg·m²). 축에 정렬된 직육면체는 0이다.-->
            <ixy>0</ixy>
            <!--관성 텐서 XZ 비대각 성분(kg·m²).-->
            <ixz>0</ixz>
            <!--Y축 주위 관성 모멘트(kg·m²).-->
            <iyy>1</iyy>
            <!--관성 텐서 YZ 비대각 성분(kg·m²).-->
            <iyz>0</iyz>
            <!--Z축 주위 관성 모멘트(kg·m²).-->
            <izz>1</izz>
          </inertia>
        </inertial>
        <!--이 강체에 바람 효과를 적용할지 지정한다.-->
        <enable_wind>false</enable_wind>
      </link>
      <!--같은 모델 안의 강체끼리 충돌을 계산할지 지정한다.-->
      <self_collide>false</self_collide>
    </model>
    <!--wall_source_south: 창고 외곽 벽 / 출발 창고 / north=북쪽, south=남쪽, outer=바깥쪽 끝. 중심 XYZ=(-13 -8.1 1.25)m, 상자 형상 XYZ 크기=18.4 × 0.2 × 2.5m.-->
    <model name="wall_source_south">
      <!--true=바닥·벽·선반처럼 움직이지 않음, false=중력과 충돌로 움직이는 상자.-->
      <static>true</static>
      <!--월드 기준 위치·회전: x y z roll pitch yaw. 앞 세 값은 m, 뒤 세 값은 rad.-->
      <pose>-13 -8.0999999999999996 1.25 0 0 0</pose>
      <!--물체를 구성하는 하나의 강체. 아래에 충돌 형상·외형·질량을 정의한다.-->
      <link name="body">
        <!--물리 충돌·접촉 계산에 쓰는 형상. 화면에 보이는 visual과 역할이 다르다.-->
        <collision name="collision">
          <!--충돌체 또는 시각 외형의 기하학적 모양.-->
          <geometry>
            <!--직육면체 형상. size에서 세 축의 길이를 지정한다.-->
            <box>
              <!--직육면체의 X길이 Y길이 Z높이(m). pose는 모서리가 아닌 중심 위치다.-->
              <size>18.399999999999999 0.20000000000000001 2.5</size>
            </box>
          </geometry>
          <!--충돌 표면의 마찰·반발·접촉 설정. 비어 있는 세부 항목은 엔진 기본값을 사용한다.-->
          <surface>
            <!--바닥·상자·로봇 사이 미끄러짐에 영향을 주는 마찰 설정.-->
            <friction>
              <!--ODE 형식의 표면 설정. 여기서 값이 없으면 해당 기본 설정을 사용한다.-->
              <ode />
            </friction>
            <!--충돌 후 튀어 오르는 정도를 정하는 반발 설정. 비어 있으면 기본값.-->
            <bounce />
            <!--충돌 접촉 계산 옵션. 비어 있으면 기본값.-->
            <contact />
          </surface>
        </collision>
        <!--화면과 카메라에 보이는 외형. 이 항목만으로 물리 충돌이 생기지는 않는다.-->
        <visual name="visual">
          <!--충돌체 또는 시각 외형의 기하학적 모양.-->
          <geometry>
            <!--직육면체 형상. size에서 세 축의 길이를 지정한다.-->
            <box>
              <!--직육면체의 X길이 Y길이 Z높이(m). pose는 모서리가 아닌 중심 위치다.-->
              <size>18.399999999999999 0.20000000000000001 2.5</size>
            </box>
          </geometry>
          <!--물체 표시 색상과 조명 반응. 색상으로 크기 적합 샘플을 구분한다.-->
          <material>
            <!--주변광에 반응하는 색 R G B A. 각 성분은 보통 0~1이고 A는 불투명도다.-->
            <ambient>0.600000024 0.660000026 0.720000029 1</ambient>
            <!--확산광에 반응하는 색 R G B A.-->
            <diffuse>0.600000024 0.660000026 0.720000029 1</diffuse>
          </material>
          <!--이 물체 또는 조명이 그림자를 만드는지 지정한다.-->
          <cast_shadows>false</cast_shadows>
        </visual>
        <!--모델 기준 위치·회전: x y z roll pitch yaw. 앞 세 값은 m, 뒤 세 값은 rad.-->
        <pose>0 0 0 0 0 0</pose>
