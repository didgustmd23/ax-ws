      <!--true=바닥·벽·선반처럼 움직이지 않음, false=중력과 충돌로 움직이는 상자.-->
      <static>false</static>
      <!--월드 기준 위치·회전: x y z roll pitch yaw. 앞 세 값은 m, 뒤 세 값은 rad.-->
      <pose>-15.200000 -5.000000 0.122000 0.000000 0.000000 0.000000</pose>
      <!--물체를 구성하는 하나의 강체. 아래에 충돌 형상·외형·질량을 정의한다.-->
      <link name="body">
        <!--질량·무게중심·관성 텐서. static 물체의 값은 월드 저장 시 보존된 기본값일 수 있다.-->
        <inertial>
          <!--강체 질량(kg). 동적 샘플 상자의 값은 시험용 가정이며 실측 적재 중량이 아니다.-->
          <mass>0.64999999999999991</mass>
          <!--회전 운동 계산용 관성 텐서(kg·m²). 질량 중심 좌표계 기준이다.-->
          <inertia>
            <!--X축 주위 관성 모멘트(kg·m²).-->
            <ixx>0.0057416666666666658</ixx>
            <!--Y축 주위 관성 모멘트(kg·m²).-->
            <iyy>0.0065054166666666654</iyy>
            <!--Z축 주위 관성 모멘트(kg·m²).-->
            <izz>0.0060070833333333322</izz>
            <!--관성 텐서 XY 비대각 성분(kg·m²). 축에 정렬된 직육면체는 0이다.-->
            <ixy>0</ixy>
            <!--관성 텐서 XZ 비대각 성분(kg·m²).-->
            <ixz>0</ixz>
            <!--관성 텐서 YZ 비대각 성분(kg·m²).-->
            <iyz>0</iyz>
          </inertia>
          <!--링크의 질량 중심 기준 위치·회전: x y z roll pitch yaw. 앞 세 값은 m, 뒤 세 값은 rad.-->
          <pose>0 0 0 0 0 0</pose>
        </inertial>
        <!--물리 충돌·접촉 계산에 쓰는 형상. 화면에 보이는 visual과 역할이 다르다.-->
        <collision name="collision">
          <!--충돌체 또는 시각 외형의 기하학적 모양.-->
          <geometry>
            <!--직육면체 형상. size에서 세 축의 길이를 지정한다.-->
            <box>
              <!--직육면체의 X길이 Y길이 Z높이(m). pose는 모서리가 아닌 중심 위치다.-->
              <size>0.25 0.22 0.23999999999999999</size>
            </box>
          </geometry>
          <!--충돌 표면의 마찰·반발·접촉 설정. 비어 있는 세부 항목은 엔진 기본값을 사용한다.-->
          <surface>
            <!--바닥·상자·로봇 사이 미끄러짐에 영향을 주는 마찰 설정.-->
            <friction>
              <!--ODE 형식의 표면 설정. 여기서 값이 없으면 해당 기본 설정을 사용한다.-->
              <ode />
            </friction>
            <!--충돌 후 튀어 오르는 정도를 정하는 반발 설정. 비어 있으면 기본값.-->
            <bounce />
            <!--충돌 접촉 계산 옵션. 비어 있으면 기본값.-->
            <contact />
          </surface>
        </collision>
        <!--화면과 카메라에 보이는 외형. 이 항목만으로 물리 충돌이 생기지는 않는다.-->
        <visual name="visual">
          <!--충돌체 또는 시각 외형의 기하학적 모양.-->
          <geometry>
            <!--직육면체 형상. size에서 세 축의 길이를 지정한다.-->
            <box>
              <!--직육면체의 X길이 Y길이 Z높이(m). pose는 모서리가 아닌 중심 위치다.-->
              <size>0.25 0.22 0.23999999999999999</size>
            </box>
          </geometry>
          <!--물체 표시 색상과 조명 반응. 색상으로 크기 적합 샘플을 구분한다.-->
          <material>
            <!--주변광에 반응하는 색 R G B A. 각 성분은 보통 0~1이고 A는 불투명도다.-->
            <ambient>0.850000024 0.620000005 0.330000013 1</ambient>
            <!--확산광에 반응하는 색 R G B A.-->
            <diffuse>0.850000024 0.620000005 0.330000013 1</diffuse>
          </material>
          <!--이 물체 또는 조명이 그림자를 만드는지 지정한다.-->
          <cast_shadows>false</cast_shadows>
        </visual>
        <!--모델 기준 위치·회전: x y z roll pitch yaw. 앞 세 값은 m, 뒤 세 값은 rad.-->
        <pose>0 0 0 0 0 0</pose>
        <!--이 강체에 바람 효과를 적용할지 지정한다.-->
        <enable_wind>false</enable_wind>
      </link>
      <!--같은 모델 안의 강체끼리 충돌을 계산할지 지정한다.-->
      <self_collide>false</self_collide>
    </model>
