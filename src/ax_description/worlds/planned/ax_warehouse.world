      <pose>3 -5.5 0.002 0 0 0</pose>
      <link name="marking">
        <visual name="marking">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>2.2 2.2</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.38 0.35 0.62 1</ambient>
            <diffuse>0.38 0.35 0.62 1</diffuse>
          </material>
          <cast_shadows>false</cast_shadows>
        </visual>
      </link>
    </model>
    <model name="zone_sensor_test">
      <static>true</static>
      <pose>-5 -4.5 0.002 0 0 0</pose>
      <link name="marking">
        <visual name="marking">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>6 4</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.62 0.62 0.56 1</ambient>
            <diffuse>0.62 0.62 0.56 1</diffuse>
          </material>
          <cast_shadows>false</cast_shadows>
        </visual>
      </link>
    </model>
    <!--Keep station_src at (8,3), station_dst at (8,-3), and the existing 0.2 m / 0.5 kg box for tool compatibility.-->
    <model name="station_src">
      <static>true</static>
      <pose>8 3 0.4 0 0 0</pose>
      <link name="table">
        <collision name="table_collision">
          <geometry>
            <box>
              <size>1.0 1.0 0.8</size>
            </box>
          </geometry>
        </collision>
        <visual name="table_visual">
          <geometry>
            <box>
              <size>1.0 1.0 0.8</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.3 0.4 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="station_dst">
      <static>true</static>
      <pose>8 -3 0.4 0 0 0</pose>
      <link name="table">
        <collision name="table_collision">
          <geometry>
            <box>
              <size>1.0 1.0 0.8</size>
            </box>
          </geometry>
        </collision>
        <visual name="table_visual">
          <geometry>
            <box>
              <size>1.0 1.0 0.8</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.5 0.4 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="test_box">
      <pose>8 3 0.91 0 0 0</pose>
      <link name="box">
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.003333333333</ixx>
            <iyy>0.003333333333</iyy>
            <izz>0.003333333333</izz>
          </inertia>
        </inertial>
        <collision name="box_collision">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="box_visual">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.9 0.45 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!--Reference board west of the empty 6 x 4 m test zone. Approach from +X; distances require sensor-origin calibration.-->
    <model name="sensor_reference_board">
      <static>true</static>
      <pose>-8.8 -4.5 0.7 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.04 0.8 0.8</size>
            </box>
